# Supabase project config — leave unset to run in demo/in-memory mode
# (every portal stays reachable with a hardcoded demo identity, no login).
# Fill these in from your Supabase project settings to enable real data
# persistence and real authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App metadata
NEXT_PUBLIC_APP_NAME=Consult America
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo account password used by `npm run seed:supabase` when creating the
# Supabase Auth accounts for the seeded demo people (Michael Brown,
# Jennifer Lee). Only used by that script — not read by the app itself.
SEED_DEMO_PASSWORD=ConsultAmerica!Demo1
