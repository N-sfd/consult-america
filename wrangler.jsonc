{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "consult-america",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Attach after consult-america.dev exists as a zone on this Cloudflare account:
  // "routes": [
  //   { "pattern": "consult-america.dev", "custom_domain": true },
  //   { "pattern": "www.consult-america.dev", "custom_domain": true }
  // ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "consult-america"
    }
  ]
}
